# Required: the HTTPS origin members use, served by your reverse proxy.
APP_URL=https://demo.example.com

# Everything below is optional. A commented line shows the default; an empty value has none.
# Remove the leading "# " to change a setting.

# --- Deployment ---
# CSWATCH_IMAGE=ghcr.io/buco7854/cswatch:latest
# CSWATCH_ASSETS_IMAGE=ghcr.io/buco7854/cswatch:assets-latest
# Port on this machine, published on 127.0.0.1 for the reverse proxy.
# HOST_PORT=8000
# Port inside the container. Compose expects the default.
# PORT=8000
# Turn off only for local development over HTTP.
# COOKIE_SECURE=true
# Exact proxy IPs or CIDRs, comma-separated. Without them, forwarded addresses are ignored.
# TRUSTED_PROXY_IPS=
# LOG_LEVEL=info

# --- Instance policy ---
# Setting one of these locks it and overrides the Administration page.
# PUBLIC_ACCESS=true
# GUEST_UPLOADS_ENABLED=true
# REGISTRATIONS_ENABLED=true
# STEAM_ENABLED=false
# FACEIT_ENABLED=false
# TRANSCRIPTION_ENABLED=false
# Prepares official maps automatically with the assets service.
# AUTO_OFFICIAL_MAPS_ENABLED=false

# --- Accounts ---
# First administrator. Set both or neither. Without them, /setup asks for the one-time code in /data/setup-token.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# SESSION_DAYS=7
# Encrypts saved credentials, 64 hexadecimal characters: openssl rand -hex 32
# Without it, the web service creates encryption.key in the data directory.
# ENCRYPTION_KEY=

# --- Steam and FACEIT ---
# Needed for Steam match sync, not for Steam sign-in.
# STEAM_API_KEY=
# FACEIT_API_KEY=
# Approved Downloads API token, separate from the Data API key.
# FACEIT_DOWNLOAD_TOKEN=
# Extra HTTPS hostnames FACEIT confirmed for your approval, comma-separated.
# FACEIT_RESOURCE_HOSTS=
# FACEIT_SIGNED_DOWNLOAD_HOSTS=

# --- Limits ---
# MAX_UPLOAD_MB=512
# MAX_EXPANDED_MB=2048
# USER_DEMO_LIMIT=50
# USER_STORAGE_MB=2048
# GLOBAL_STORAGE_MB=20480
# Days before a demo is deleted. 0 keeps demos.
# RETENTION_DAYS=30
# Guest uploads are private to an expiring browser cookie.
# GUEST_RETENTION_HOURS=24
# GUEST_DEMO_LIMIT=3
# GUEST_STORAGE_MB=512

# --- Demo parser ---
# PARSER_TIMEOUT_SECONDS=300
# PARSER_MEMORY_MB=4096
# Needs Linux Landlock ABI 3 (kernel 6.2). Never turn it off for untrusted uploads.
# PARSER_SANDBOX=required
# Absolute path that replaces the binary built into the image.
# PARSER_SANDBOX_BINARY=

# --- Local subtitles (CPU only) ---
# Prepare the model first and enable the Compose transcription profile.
# TRANSCRIPTION_MODEL_DIR=
# TRANSCRIPTION_LANGUAGE=auto
# TRANSCRIPTION_TIMEOUT_SECONDS=600
# Recorded audio per demo. Longer recordings get partial captions.
# TRANSCRIPTION_MAX_AUDIO_SECONDS=600
