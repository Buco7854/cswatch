# Copy to .env and set the public HTTPS origin served by your reverse proxy.
APP_URL=https://demo.example.com

# Only APP_URL is required. Uncomment optional settings to override their defaults.
# Replace values in angle brackets with your own before uncommenting.

# Deployment
# Publish on all IPv4 interfaces by default. Set this to the Docker host’s LAN IP
# to serve only that interface, or 127.0.0.1 for a proxy on the same machine.
# HOST_BIND_IP=0.0.0.0
# HOST_PORT=8000
# CSWATCH_IMAGE=ghcr.io/buco7854/cswatch:latest
# CSWATCH_ASSETS_IMAGE=ghcr.io/buco7854/cswatch:assets-latest
# COOKIE_SECURE=true
# LOG_LEVEL=info
# Trust forwarding headers only from your reverse proxy's address or CIDR.
# TRUSTED_PROXY_IPS=<proxy-address-or-cidr>
# Optional. Restrict Administration to browser client IPs or CIDRs.
# Behind a proxy, trust its exact address above. Have it overwrite X-Real-IP with the
# client address or send a canonical X-Forwarded-For chain.
# ADMIN_ALLOWED_IPS=<admin-network-cidr>

# First administrator
# By default, open /setup and use the code from /data/setup-token.
# For unattended setup, supply both credentials. The email is optional.
# ADMIN_USERNAME=<admin-username>
# ADMIN_PASSWORD=<unique-admin-password>
# ADMIN_EMAIL=<admin-email>
# SESSION_DAYS=7
# By default the web service generates /data/encryption.key. To supply your own
# before first startup, generate 32 bytes with: openssl rand -hex 32
# ENCRYPTION_KEY=<64-hexadecimal-characters>

# Instance policy
# Leaving these commented lets administrators change them in the app.
# Uncommenting a value locks that setting, even if it matches the default.
# PUBLIC_ACCESS=true
# GUEST_UPLOADS_ENABLED=true
# REGISTRATIONS_ENABLED=true
# STEAM_ENABLED=false
# FACEIT_ENABLED=false
# EMAIL_DELIVERY_ENABLED=false
# TRANSCRIPTION_ENABLED=false
# AUTO_OFFICIAL_MAPS_ENABLED=false
# MFA_REQUIRED_ROLES=admin

# Email verification and password recovery
# Set the four relay details, then enable email delivery in Administration.
# Use authenticated SMTP over implicit TLS. The default port is 465.
# SMTP_HOST=<relay-hostname>
# SMTP_PORT=465
# SMTP_FROM=<sender-email>
# SMTP_USERNAME=<relay-username>
# SMTP_PASSWORD=<relay-password>

# Steam and FACEIT
# Steam match sync requires a Steam API key. Steam sign-in works without one.
# STEAM_API_KEY=<steam-api-key>
# FACEIT_API_KEY=<faceit-data-api-key>
# Automatic FACEIT downloads require a separately approved Downloads API token.
# FACEIT_DOWNLOAD_TOKEN=<approved-download-token>
# Extra HTTPS hosts explicitly confirmed by FACEIT for your approval.
# FACEIT_RESOURCE_HOSTS=<approved-hostnames>
# FACEIT_SIGNED_DOWNLOAD_HOSTS=<approved-hostnames>

# Uploads and storage
# MAX_UPLOAD_MB=512
# MAX_EXPANDED_MB=2048
# USER_DEMO_LIMIT=50
# USER_STORAGE_MB=2048
# GLOBAL_STORAGE_MB=20480
# RETENTION_DAYS=30
# Set RETENTION_DAYS to 0 to keep demos indefinitely.
# GUEST_RETENTION_HOURS=24
# GUEST_DEMO_LIMIT=3
# GUEST_STORAGE_MB=512

# Processing
# PARSER_TIMEOUT_SECONDS=300
# PARSER_MEMORY_MB=4096
# PARSER_SANDBOX=required
# Optional absolute path to an installed sandbox launcher inside the container.
# PARSER_SANDBOX_BINARY=<absolute-launcher-path>

# Offline subtitles
# Prepare and mount the model read-only before enabling the transcription profile.
# TRANSCRIPTION_MODEL_DIR=<mounted-model-directory>
# TRANSCRIPTION_LANGUAGE=auto
# TRANSCRIPTION_TIMEOUT_SECONDS=600
# TRANSCRIPTION_MAX_AUDIO_SECONDS=600
