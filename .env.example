# Optional Docker image tag/digest override; empty uses ghcr.io/buco7854/cswatch:latest.
CSWATCH_IMAGE=
# Optional asset-worker image override. Empty uses the separately published assets target.
CSWATCH_ASSETS_IMAGE=
# Production: HTTPS origin served by your existing reverse proxy.
APP_URL=https://demo.example.com
COOKIE_SECURE=true
PORT=8000
# Leave toggles absent/empty to manage them in the admin UI.
# Set true/false here to lock a setting and override the admin UI.
PUBLIC_ACCESS=
GUEST_UPLOADS_ENABLED=
REGISTRATIONS_ENABLED=
STEAM_ENABLED=
FACEIT_ENABLED=
TRANSCRIPTION_ENABLED=
# Optional approved official-map preparation. Empty permits admin UI management, default off.
# Requires the assets Compose profile and an operator-approved exact-version catalog.
# No latest-map guessing, arbitrary URLs or Steam login credentials are accepted.
AUTO_OFFICIAL_MAPS_ENABLED=
STEAM_API_KEY=
FACEIT_API_KEY=
# Separate approved Downloads API token, not the Data API key.
FACEIT_DOWNLOAD_TOKEN=
# Optional first administrator. Both values are required together. Existing administrators are never reset.
# Without these values, the setup page requires the one-time code from /data/setup-token.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Anonymous uploads are private to an expiring browser cookie, not listed publicly.
GUEST_RETENTION_HOURS=24
GUEST_DEMO_LIMIT=3
GUEST_STORAGE_MB=512
MAX_UPLOAD_MB=512
MAX_EXPANDED_MB=2048
USER_STORAGE_MB=2048
GLOBAL_STORAGE_MB=20480
USER_DEMO_LIMIT=50
PARSER_TIMEOUT_SECONDS=300
PARSER_MEMORY_MB=4096
# Linux Landlock ABI >=3 (kernel >=6.2) required. Never disable for untrusted public uploads.
PARSER_SANDBOX=required
# Normally use the binary built into the image. Optional absolute local override.
PARSER_SANDBOX_BINARY=
# Optional local CPU subtitles. Prepare the model first; enable the Compose transcription profile.
# Empty model path leaves automatic subtitles unavailable. No cloud fallback or runtime downloads.
TRANSCRIPTION_MODEL_DIR=
TRANSCRIPTION_LANGUAGE=auto
TRANSCRIPTION_TIMEOUT_SECONDS=600
# Per-demo recorded audio budget; longer recordings produce explicitly partial captions.
TRANSCRIPTION_MAX_AUDIO_SECONDS=600
SESSION_DAYS=7
# Set 0 to disable automatic retention deletion.
RETENTION_DAYS=30
# Exact proxy IPs/CIDRs only. Leave empty to ignore forwarded addresses.
TRUSTED_PROXY_IPS=
LOG_LEVEL=info
